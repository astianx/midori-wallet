MIDORI_ENV=local
MIDORI_NETWORK=base
MIDORI_CHAIN_ID=8453
MIDORI_RPC_URL=https://mainnet.base.org
MIDORI_DEPLOYMENT=manual
MIDORI_TRANSACTIONS_ENABLED=false
MIDORI_SPONSORSHIP_ENABLED=false
MIDORI_ALLOW_PUBLISH=false
MIDORI_BUILD_PROFILE=debug
MIDORI_SIGN_ARTIFACTS=false
VITE_SITE_URL=https://midoriwallet.com/wallet/
VITE_API_ORIGIN=https://midoriwallet.com

# Configure the private WDK_INDEXER_API_KEY and WDK_INDEXER_BASE_URL in server/.env.
VITE_WALLETCONNECT_ID=

# Changelly Exchange API v2. Server only; configure these in server/.env.
CHANGELLY_ENABLED=false
CHANGELLY_API_SECRET=
# Optional: derived from the RSA public key when empty.
CHANGELLY_API_KEY=
