{
  "name": "@midori/electron",
  "private": true,
  "productName": "Midori Wallet",
  "executableName": "midori-wallet",
  "version": "0.1.0",
  "description": "Shared Midori Wallet desktop shell",
  "license": "MIT",
  "type": "module",
  "main": "electron.js",
  "config": {
    "forge": "forge.config.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env start.mjs",
    "build": "node --env-file-if-exists=.env build.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "node ../scripts/publish-artifact.mjs --target electron",
    "lint": "eslint --report-unused-disable-directives .",
    "clean": "rm -rf ./dist && rm -rf ./out"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-appx": "^7.10.2",
    "@electron-forge/maker-base": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-flatpak": "^7.10.2",
    "@electron-forge/maker-pkg": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/publisher-gcs": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "app-builder-lib": "^26.16.1",
    "ejs": "^3.1.9",
    "electron": "^38.7.2",
    "electron-packager-languages": "^0.6.0",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "@sentry/electron": "^7.5.0",
    "electron-log": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <13"
  }
}
