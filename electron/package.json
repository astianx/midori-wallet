{
  "name": "@midori/electron",
  "private": true,
  "productName": "Midori Wallet",
  "executableName": "midori-wallet",
  "version": "0.1.0",
  "description": "Shared Midori Wallet desktop shell",
  "license": "MIT",
  "type": "module",
  "main": "electron.js",
  "config": {
    "forge": "forge.config.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env start.mjs",
    "build": "node ../scripts/build.mjs electron",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "node ../scripts/publish-artifact.mjs --target electron",
    "lint": "npm --prefix .. run lint -- electron",
    "clean": "rm -rf ./dist && rm -rf ./out"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "electron": "45.2.1"
  },
  "dependencies": {
    "electron-log": "5.4.3"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <13"
  }
}
