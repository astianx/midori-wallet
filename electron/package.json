{
  "name": "@midori/electron",
  "private": true,
  "productName": "Midori Wallet",
  "executableName": "midori-wallet",
  "version": "1.0.4",
  "description": "Midori Wallet for USDT and USDC on Base",
  "license": "MIT",
  "type": "module",
  "main": "electron.js",
  "config": {
    "forge": "forge.config.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env start.mjs",
    "build": "node --env-file-if-exists=.env build.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "node -e \"throw new Error('Publication is a separate manual operation')\"",
    "lint": "npm --prefix .. run lint -- electron",
    "clean": "rm -rf ./dist && rm -rf ./out"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "electron": "45.2.1"
  },
  "dependencies": {
    "electron-log": "5.4.3"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <13"
  },
  "author": "Midori Wallet"
}
