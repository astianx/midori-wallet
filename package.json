{
  "name": "midori-wallet",
  "private": true,
  "version": "0.1.0",
  "description": "Shared Midori Wallet preparation and development tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <13"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:server": "npm --prefix server run server",
    "dev:electron": "npm --prefix electron run start",
    "build:web": "npm --prefix web run build",
    "build:electron": "npm --prefix electron run build",
    "build:android": "npm --prefix phonegap run android",
    "build:ios": "npm --prefix phonegap run ios",
    "lint": "eslint .",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:backup": "npm --prefix server run db:backup"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "playwright-core": "1.64.1"
  }
}
