VITE_BUILD_TYPE=phonegap
VITE_PLATFORM=android
VITE_DISTRIBUTION=android-apk
VITE_NAME=midori-wallet
VITE_VERSION=1.0.6
VITE_COMMIT=local
# VITE_SITE_URL and VITE_API_ORIGIN inherit from ../.env. Add them here to override.
VITE_API_CSP=
VITE_SITE_URL_TOR=
VITE_API_CSP_TOR=
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_UPDATE_REPOSITORY=
VITE_UPDATE_CHANNEL=
VITE_UPDATE_PUBLIC_KEY=
MIDORI_BUILD_PROFILE=debug
MIDORI_SIGN_ARTIFACTS=false

# WDK Indexer uses server/.env; never bundle its API key in VITE_ variables.

VITE_SENTRY_ENABLED=true
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
