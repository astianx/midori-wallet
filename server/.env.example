NODE_ENV=development
MIDORI_NETWORK=base
MIDORI_CHAIN_ID=8453
MIDORI_PUBLIC_ORIGIN=http://localhost:5173
MIDORI_API_HOST=127.0.0.1
MIDORI_API_PORT=8080
MIDORI_DB_POOL_SIZE=10
MIDORI_RPC_URL=https://mainnet.base.org
MIDORI_TRANSACTIONS_ENABLED=false
MIDORI_SPONSORSHIP_ENABLED=false
MIDORI_DEPLOYMENT=manual
DATABASE_URL=postgresql://midori_wallet_app@127.0.0.1:5432/midori_wallet
MIDORI_CHALLENGE_SECONDS=120
MIDORI_SESSION_SECONDS=86400
MIDORI_RATE_LIMIT=60
MIDORI_MAX_DEVICES=100
MIDORI_WORKER_INTERVAL_MS=60000

MIDORI_NATIVE_ORIGINS=https://localhost,app://localhost

MIDORI_ALLOWED_ORIGINS=
MIDORI_INDEX_ENABLED=false
MIDORI_INDEX_START_BLOCK=0
MIDORI_INDEX_RECENT_BLOCKS=100
MIDORI_INDEX_BLOCK_BATCH=1000
MIDORI_INDEX_ACCOUNT_BATCH=10
MIDORI_INDEX_CONFIRMATIONS=12

# Payment provider configuration. Keep header credentials on the server only.
MIDORI_BUNDLER_URL=https://api.candide.dev/public/v3/8453
MIDORI_PAYMASTER_URL=https://api.candide.dev/public/v3/8453
MIDORI_PAYMASTER_ADDRESS=0x8b1f6cb5d062aa2ce8d581942bbb960420d875ba
MIDORI_PAYMASTER_PROVIDER=candide
MIDORI_BUNDLER_HEADERS={}
MIDORI_PAYMASTER_HEADERS={}
MIDORI_MAX_GAS_USDT_ATOMIC=1000000
MIDORI_PAYMENT_QUOTE_SECONDS=120
MIDORI_PAYMENT_POLL_MS=3000
MIDORI_PAYMENT_RECONCILE_RANGE=2000
MIDORI_SPONSORSHIP_POLICY_ID=
MIDORI_SPONSOR_DAILY_BUDGET_WEI=
MIDORI_GAS_RECIPIENTS=
# A dedicated read endpoint avoids coupling indexing to payment-provider limits.
MIDORI_INDEX_RPC_URL=https://base.gateway.tenderly.co
MIDORI_INDEX_BACKFILL_BATCHES=10

# Disabled until all three values are configured. The public key is Ed25519 base64url.
MIDORI_UPDATE_REPOSITORY=
MIDORI_UPDATE_CHANNEL=
MIDORI_UPDATE_PUBLIC_KEY=

# Transak fiat on/off-ramp (buy/sell crypto). Keep the API secret on the
# server only; it is never sent to the browser. STAGING is for testing with
# non-real funds; set PRODUCTION explicitly for live orders.
MIDORI_TRANSAK_ENABLED=false
MIDORI_TRANSAK_API_KEY=
MIDORI_TRANSAK_API_SECRET=
MIDORI_TRANSAK_ENVIRONMENT=STAGING
MIDORI_TRANSAK_REFERRER_DOMAIN=
