{
  "name": "@midori/server",
  "private": true,
  "version": "1.0.4",
  "description": "Midori PostgreSQL API v1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=.env --import ./instrument.js server.js",
    "wdk:indexer:check": "node --env-file-if-exists=.env scripts/check-wdk-indexer.mjs",
    "server:watch": "node --env-file-if-exists=.env --watch --import ./instrument.js server.js",
    "test": "node --test --experimental-test-isolation=none test/*.test.mjs",
    "worker": "node --env-file-if-exists=.env --import ./instrument.js worker.js",
    "db:migrate": "node --env-file-if-exists=.env.migrations scripts/migrate.mjs",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.mjs",
    "db:backup": "node --env-file-if-exists=.env.migrations scripts/backup.mjs",
    "db:restore": "node --env-file-if-exists=.env.migrations scripts/restore.mjs",
    "account:create": "node --env-file-if-exists=.env scripts/create-account.mjs",
    "db:verify": "node --env-file-if-exists=.env.migrations scripts/verify-postgres.mjs",
    "contract:build": "node scripts/build-openapi.mjs",
    "account:inspect": "node --env-file-if-exists=.env scripts/inspect-account.mjs",
    "server:transak-staging": "node --env-file=.env.transak-staging --import ./instrument.js server.js",
    "worker:transak-staging": "node --env-file=.env.transak-staging --import ./instrument.js worker.js",
    "sentry:check": "node --env-file-if-exists=.env scripts/check-sentry.mjs",
    "changelly:check": "node --env-file-if-exists=.env scripts/check-changelly.mjs"
  },
  "dependencies": {
    "@sentry/node": "11.12.0",
    "@simplewebauthn/server": "14.0.3",
    "@transak/wdk-protocol-fiat-transak": "1.0.2",
    "abstractionkit": "0.4.0",
    "ethers": "6.17.0",
    "express": "4.22.3",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <13"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
